# ── AI provider ─────────────────────────────────────────────
# local | openai | anthropic | openrouter
# local works with no key and generates deterministic drafts.
AI_PROVIDER=local
AI_MODEL=
# Optional. Required for non-local providers.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# Optional custom OpenAI-compatible endpoint (for local LLMs, vLLM, Ollama proxy).
AI_BASE_URL=

# ── App ─────────────────────────────────────────────────────
# Public base URL used by the server-side export renderer.
APP_URL=http://localhost:3070
# Storage directory (defaults to ./data)
DATA_DIR=
# Chrome/Edge executable for PDF + PPTX rendering. Auto-detected when empty.
CHROME_PATH=
# Export image scale for PPTX (2 = 2560×1440)
EXPORT_SCALE=2
