# ── AI provider ─────────────────────────────────────────────
# local | openai | anthropic | openrouter
# local은 키 없이 결정론적 초안을 생성합니다.
# 원격 제공자를 선택해도 키가 없거나 호출이 실패하면 로컬 엔진으로 폴백하고 화면에 안내합니다.
# UI(/settings)에서 저장한 provider/model/baseUrl은 이 환경변수보다 우선합니다.
AI_PROVIDER=local
AI_MODEL=
# 원격 제공자에 필요합니다. 비워 두면 로컬 생성 경로를 사용합니다.
# UI에서 입력한 키는 서버 SQLite의 secrets 테이블에 저장됩니다.
# API 응답에는 전체 키가 아니라 첫 6자···마지막 4자만 마스킹되어 표시됩니다.
# 실제 키 값을 이 파일에 커밋하지 마세요.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OPENROUTER_API_KEY=
# 선택 사항: OpenAI 호환 게이트웨이/로컬 LLM 프록시 주소
AI_BASE_URL=

# ── App ─────────────────────────────────────────────────────
# 서버 측 내보내기 렌더러가 사용할 공개 주소입니다.
# dev/start 기본 포트는 3070입니다. 포트를 바꾸면 이 값도 바꿔 주세요.
APP_URL=http://localhost:3070
# 데이터 저장 디렉터리입니다. 비워 두면 프로젝트 루트의 ./data를 사용합니다.
# slideforge.db, uploads/, exports/가 이 아래에 만들어집니다.
DATA_DIR=
# PDF/PPTX 렌더링에 사용할 Chrome/Chromium 실행 파일입니다.
# 비워 두면 설치된 브라우저 경로를 자동 탐색합니다.
# 예시(Windows): C:\Program Files\Google\Chrome\Application\chrome.exe
CHROME_PATH=
# PPTX용 슬라이드 캡처 배율입니다. 2 = 2560×1440
EXPORT_SCALE=2
